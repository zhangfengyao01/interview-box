# 依赖与构建产物
node_modules/
dist/
unpackage/
.hbuilderx/

# 设计稿切片：约 12MB，只用于本地逐屏比对，不入库
preview/_ref/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local

# 环境变量与密钥（客户端本不存密钥，这里只是兜底）
.env
.env.*
!.env.example

# 本地真机验证用的自签证书（serve_local.py 现场生成，别提交）
proxy/_local/

# Python 缓存（代理是自签自跑的独立进程，产物不入库）
__pycache__/
*.pyc

# 校验脚本的中间产物
.verify-segment.bundle.mjs

# 日志
*.log
npm-debug.log*
