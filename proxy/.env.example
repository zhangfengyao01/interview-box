# 复制成 .env 再填值（.env 已在 .gitignore 里，不会被提交）
#
# 智谱开放平台 https://open.bigmodel.cn → 右上角「API Keys」新建。
# GLM-4-Flash 永久免费，够个人练手用。
LLM_API_KEY=

# 换别的厂商只改这三行，代码不用动（都必须兼容 OpenAI 的 /chat/completions）：
#   硅基流动   https://api.siliconflow.cn/v1        模型 Qwen/Qwen2.5-7B-Instruct
#   DeepSeek   https://api.deepseek.com/v1          模型 deepseek-chat
#   本地 Ollama http://127.0.0.1:11434/v1           模型 qwen2.5:7b（Key 随便填）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# 没有 Key、只想先看 UI 效果时设成 1：不调真实模型，直接返回结构正确的假答案。
MOCK=

# —— 暴露到公网时必设 ——

# 访问令牌：设了之后请求必须带 Authorization: Bearer <token>，否则 401。
# 客户端「设置 → AI 答案助手 → 访问令牌」填同一个值。留空 = 不校验。
PROXY_TOKEN=

# 每 IP 每分钟请求数。免费额度被刷爆是分钟级的事，别设太宽松。0 = 不限。
RATE_LIMIT_PER_MIN=10

# 额外放行的跨域源（逗号分隔）。本机与私有网段已默认放行，
# 公网域名要写在这里；别在生产写 *。
ALLOWED_ORIGINS=
